.index-page-wrapper {
  background-color: var(--white);
}

pre.prettyprint {
  border: 1px solid var(--gray-60);
  margin-bottom: 0;
  padding: 9px;
}

.panel-heading {
  cursor: pointer;
}

.login-menu {
  padding: 15px;
  min-width: 250px;
}

.index-first-line {
  background-color: rgb(255, 250, 190);
  background-image: linear-gradient(rgb(255, 250, 190) 0px, rgb(255, 250, 190) 100%);
  background-repeat: repeat-x;
  box-sizing: border-box;
  display: block;
  position: relative;
}

.text-darkgray {
  color: rgb(85, 85, 85);
}

.competition-header h2 {
  letter-spacing: 1px;
  font-weight: 300;
  text-shadow: rgba(0, 0, 0, 0.0980392) 2px 2px 1px;
}

.gps-tracks-label {
  background-color: rgb(125, 166, 193);
  color: white;
}

.gps-tracks-label:hover {
  background-color: rgb(107, 145, 168);
}

.online-competitions-label {
  background-color: rgb(63, 142, 191);
  border-left-width: 1px;
  border-left-style: solid;
  border-right-width: 1px;
  border-right-style: solid;
  border-color: white;
  color: white;
}

.online-competitions-label:hover {
  background-color: rgb(56, 126, 170);
}

.competitions-label {
  background-color: rgb(61, 134, 170);
  color: white;
}

.competitions-label:hover {
  background-color: rgb(53, 116, 147);
}

.panel-winner {
  box-shadow: rgba(0, 0, 0, 0.117647) 0px 1px 6px 0px, rgba(0, 0, 0, 0.117647) 0px 1px 6px 0px;
  border-width: 0px;
}

.panel-winner .panel-heading {
  border-bottom-width: 0px;
}

.btn-browse {
  font-weight: 200;
  letter-spacing: 1.3px;
  color: white;
  border-color: white;
  margin-bottom: 15px;
}

.overlay-link {
  position: absolute;
  left: 0px;
  top: 0px;
  display: block;
  width: 100%;
  height: 100%;
  z-index: 2;
}

.how-it-works {
  background-clip: border-box;
  background-origin: padding-box;
  -webkit-background-clip: border-box;
  -webkit-background-origin: padding-box;
  -webkit-background-size: 66% 3px;
  background: url(<%= asset_path("line.png") %>) no-repeat center 156px;
  background-size: 66% 3px;
  text-align: center;
}

#first-step-hiw {
  background: url(<%= asset_path("hiw-step-1.png") %>) no-repeat center 10px;
  height: 130px;
}

#second-step-hiw {
  background: url(<%= asset_path("hiw-step-2.png") %>) no-repeat center 10px;
  height: 130px;
}

#third-step-hiw {
  background: url(<%= asset_path("hiw-step-3.png") %>) no-repeat center 10px;
  height: 130px;
}

.step-number-hiw {
  text-align: center;
  font-size: 18px;
  font-style: normal;
  font-weight: 600;
  line-height: 24px;
  color: rgb(245, 245, 245);
  background: url(<%= asset_path("spot.png") %>) no-repeat center center;
  height: 26px;
  margin-top: 15px;
}

.grayed {
  -webkit-filter: grayscale(100%);
  -moz-filter: grayscale(100%);
  -o-filter: grayscale(100%);
  -ms-filter: grayscale(100%);
  filter: grayscale(100%);
}

.grayed:hover {
  -webkit-filter: grayscale(0%);
  -moz-filter: grayscale(0%);
  -o-filter: grayscale(0%);
  -ms-filter: grayscale(0%);
  filter: grayscale(0%);
}

#gpx-sf {
  background: url(<%= asset_path("gpx.png") %>) no-repeat center center;
  background-size: auto 120px;
  height: 150px;
}

#fs-sf {
  background: url(<%= asset_path("flysight.jpg") %>) no-repeat center center;
  background-size: contain;
  height: 150px;
}

#garmin-sf {
  background: url(<%= asset_path("garmin-foretrex.jpg") %>) no-repeat center center;
  background-size: contain;
  height: 150px;
}

#wintec-sf {
  background: url(<%= asset_path("wintec.jpg") %>) no-repeat center center;
  background-size: contain;
  height: 150px;
}

#columbus-sf {
  background: url(<%= asset_path("columbus-v900.png") %>) no-repeat center center;
  background-size: contain;
  height: 150px;
}

#dual-xgps {
  background: url(<%= asset_path("dual-xgps.png") %>) no-repeat center center;
  background-size: contain;
  height: 150px;
}
