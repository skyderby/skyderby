             layout: 'components/dialog',
             locals: {
               header_actions: render('components/open_track_button', track_id: @slot.track_id),
               title: match_slot_presentation(@slot),
               dialog_size: 'lg',
               slot: @slot,
               modal: true,
               editable:
             } %>
<% end %>
