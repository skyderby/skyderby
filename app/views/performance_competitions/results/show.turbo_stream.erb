<% editable = @event.editable? && !@event.finished? && !@result.round.completed? %>

<%= turbo_stream.update 'modal-root' do %>
  <%= render partial: 'performance_competitions/results/result',
             layout: 'components/dialog',
             locals: {
               header_actions: render('components/open_track_button', track_id: @result.track_id),
               title: event_result_presentation(@result),
               dialog_size: 'lg',
               result: @result,
               modal: true,
               editable:
             } %>
<% end %>
