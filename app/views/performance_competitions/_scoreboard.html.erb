<%# locals: (event:, editable:, wind_cancellation: false, until_round: nil, scoreboard: nil) %>
<% id = ['scoreboard', ('no_wind' if wind_cancellation)].compact.join('_') %>
<% scoreboard ||= event.standings(until_round:, wind_cancellation:) %>

<% if event.surprise? && !editable %>
  <h1 class="text-muted text-center" id="<%= id %>">🙅 Let it be a Surprise</h1>
<% else %>
  <%= render 'performance_competitions/scoreboard_table_by_category',
             event:, scoreboard:, editable:, id:, comparable: true %>
<% end %>
