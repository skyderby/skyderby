<%# locals: (event:, scoreboard:, editable:, id:) %>
<% container_id = scoreboard.time_machine? ? 'scoreboard-time-machine' : id %>

<div class="<%= class_names 'scoreboard-container', (scoreboard.rounds.size > 6 && 'scoreboard-container-fluid') %>"
     data-controller="events--sticky-header" id="<%= container_id %>">
  <div class="scoreboard-scroll" data-events--sticky-header-target="container" data-action="scroll->events--sticky-header#on_horizontal_scroll">
    <table class="scoreboard-table scoreboard-table--pinned-competitor performance-competition-scoreboard-table"
           data-events--sticky-header-target="table"
           <% if scoreboard.time_machine? %>
             data-replay-scoreboard-target="scoreboard"
             data-until-round="<%= scoreboard.until_round %>"
           <% end %>>
      <%= render 'performance_competitions/scoreboard_header', event:, scoreboard:, editable: %>
      <tbody>
        <%= render 'performance_competitions/scoreboard_standings', event:, scoreboard:, rounds_by_discipline: scoreboard.rounds_by_discipline, standings: scoreboard.standings, editable: %>
      </tbody>
    </table>
  </div>
</div>
