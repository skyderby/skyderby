<% provide :title, @event.name %>
<% editable = @event.editable? %>
<%= turbo_stream_from @event, :task_scoreboard, @task, editable ? :editable : :read_only %>

<div class="show-page">
  <%= render 'performance_competitions/header', editable: %>

  <div class="show-page-content" data-controller="replay-scoreboard">
    <div class="tab-bar">
      <% @tasks.each do |task| %>
        <%= link_to t("disciplines.#{task}"), performance_competition_task_scoreboard_path(@event, task), class: class_names('tab-bar-item', ('active' if @task == task)) %>
      <% end %>
    </div>

    <% scoreboard = @until_round ? @event.task_standings(@task, until_round: @until_round, wind_cancellation: @wind_cancellation) : nil %>
    <% if @until_round %>
      <%= render 'performance_competitions/time_machine_controls', event: @event, scoreboard:, board: :task, task: @task %>
    <% else %>
      <%= render 'actions_bar', event: @event, task: @task %>
    <% end %>

    <div id="<%= @task %>_scoreboard">
      <%= render 'scoreboard', event: @event, editable:, task: @task, wind_cancellation: @wind_cancellation, until_round: @until_round, scoreboard: %>
    </div>
  </div>
</div>
