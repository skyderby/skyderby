<%# locals: (event:, editable:, task:, wind_cancellation: false, until_round: nil, scoreboard: nil) %>
<% id = [task, 'scoreboard', ('no_wind' if wind_cancellation)].compact.join('_') %>
<% scoreboard ||= event.task_standings(task, until_round:, wind_cancellation:) %>

<% if event.surprise? && !editable %>
  <h1 class="text-muted text-center" id="<%= id %>">🙅 Let it be a Surprise</h1>
<% else %>
  <%= render 'performance_competitions/scoreboard_table',
             event: event, scoreboard:, editable:, id: %>
<% end %>
