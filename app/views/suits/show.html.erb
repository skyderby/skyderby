<% provide(:title, page_title("#{@suit.manufacturer_name} #{@suit.name}")) %>
<% base = (show_params[:query] || {})[:kind] == 'base' %>

<div class="show-page suit-show">
  <%= render 'suits/header', suit: @suit, tab: (base ? :base : :skydive) %>

  <div class="show-page-content">
    <% if base && @comparison.available? %>
      <%= render 'suits/exit_performance', suit: @suit, comparison: @comparison %>
    <% elsif !base && @scoreboard&.available? %>
      <%= render 'suits/scoreboard', suit: @suit, scoreboard: @scoreboard %>
    <% end %>

    <div class="card">
      <div id="tracks-table" class="table table-hover">
        <div class="thead">
          <%= render 'tracks/table_header' %>
        </div>
        <div id="tracks-list" class="tbody">
          <%= render collection: @tracks, partial: 'tracks/track' %>
        </div>
      </div>

      <div class="flex justify-center">
        <div class="pagination">
          <%= paginate @tracks %>
        </div>
      </div>
    </div>
  </div>
</div>
