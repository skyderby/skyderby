<% content_for :head do %>
  <meta name="track-kind" content="<%= @track.kind %>">
  <meta name="track-pro-view" content="false">
<% end %>

<div class="show-page">
  <%= render partial: 'header', locals: { track: @track } %>

  <div class="track-show-content"
       data-controller="tracks--skydive-track" data-tracks--skydive-track-labels-value="<%= js_labels(:units, :charts, :track_show) %>"
       data-tracks--skydive-track-points-url-value="<%= track_points_path(@track, original_frequency: true) %>"
       data-tracks--skydive-track-weather-url-value="<%= track_weather_data_path(@track) %>"
       data-tracks--skydive-track-chart-type-value="<%= Current.charts_mode %>"
       data-tracks--skydive-track-charts-units-value="<%= Current.charts_units %>"
       data-tracks--skydive-track-tracks--range-selector-outlet="#range-selector"
       data-action="tracks--range-selector:change->tracks--skydive-track#updateRange">
    <%= render 'tracks/pro_view_notice' %>

    <div class="card-action">
      <button class="button button--ghost toggle-straight-line"
              data-tracks--skydive-track-target="straightLineButton"
              data-action="tracks--skydive-track#toggleStraightLine">
        Straight-line distance
      </button>
      <div class="dropdown settings-button">
        <%= render 'tracks/view_settings_menu' %>
      </div>
    </div>

    <%= render 'tracks/skydive_indicators' %>

    <hr class="top-buffer">

    <div class="track-jump-range" id="range-selector" data-controller="tracks--range-selector">
      <input class="hidden" type="text" name="range" data-tracks--range-selector-target="slider">

      <div class="range-shortcuts">
        <button class="button button--sm button--rounded hidden"
                data-tracks--range-selector-target="shortcut"
                data-action="tracks--range-selector#setRange"
                data-from="3000"
                data-to="2000">
          3000 — 2000<%= t('units.m') %>
        </button>
        <button class="button button--sm button--rounded hidden"
                data-tracks--range-selector-target="shortcut"
                data-action="tracks--range-selector#setRange"
                data-from="2500"
                data-to="1500">
          2500 — 1500<%= t('units.m') %>
        </button>
        <button class="button button--sm button--rounded"
                data-action="tracks--range-selector#reset">
          <%= t('tracks.show.full_jump') %>
        </button>
      </div>
    </div>

    <% if Current.charts_mode.separate? %>
      <div class="performance-flying-separate-charts">
        <div data-tracks--skydive-track-target="accuracyChart"></div>
        <div data-tracks--skydive-track-target="glideChart"></div>
        <div data-tracks--skydive-track-target="speedChart"></div>
        <div data-tracks--skydive-track-target="altitudeDistanceChart"></div>
      </div>
    <% else %>
      <div class="performance-flying-combined-chart" data-tracks--skydive-track-target="combinedChart"></div>
    <% end %>

    <div class="track-empty-state hidden"
         data-tracks--skydive-track-target="emptyState"></div>

    <blockquote class="flex flex-column">
      <%= render 'track_metadata' %>
    </blockquote>
  </div>
</div>
