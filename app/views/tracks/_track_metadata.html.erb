<% if @track.comment.present? %>
  <small>
    <%= @track.comment %>
  </small>
<% end %>

<% if @track.private_note.present? && @track.private_note_visible? %>
  <small class="track-private-note" title="<%= t('tracks.private_note.hint') %>">
    <%= icon_tag 'lock-solid' %>
    <span class="for-screen-reader"><%= t('tracks.private_note.hint') %></span>
    <%= simple_format(@track.private_note, {}, wrapper_tag: 'span') %>
  </small>
<% end %>

<small>
  <% if @track.recorded_at %>
    <%= "Recorded at #{@track.recorded_at.strftime('%d.%m.%Y %H:%M')} (UTC); " %>
  <% end %>
  <%= "Uploaded at #{@track.created_at.strftime('%d.%m.%Y %H:%M')} (UTC)" %>
</small>

<% if @track.data_frequency %>
  <small>
    <%= "Data frequency: #{@track.data_frequency.round} Hz" %>
  </small>
<% end %>

<% if @track.downloadable? %>
  <% { exit_point: @track.exit_point, landing_point: @track.landing_point }.each do |name, point| %>
    <% next if point.blank? %>
    <%= render 'tracks/track_point', label: t("tracks.metadata.#{name}"), point: %>
  <% end %>

  <% if @track.track_file&.file&.attached? %>
    <small>
      Download file:
      <%= link_to @track.track_file.file.filename, track_download_path(@track), 'data-turbo': false %>
    </small>
  <% end %>
<% end %>
