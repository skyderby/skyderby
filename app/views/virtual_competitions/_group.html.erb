<div class="vc-group">
  <h3 class="vc-group__title">
    <%= group.name %>
    <span class="vc-group__count"><%= group.size %></span>
  </h3>

  <% if group.combined_scoreboard? %>
    <%= render 'combined_card', group: group, finished: finished %>
  <% end %>

  <% if group.cards.any? %>
    <div class="vc-cards">
      <% group.cards.each do |competition| %>
        <%= render 'card', competition: competition, count: group.athlete_count(competition), finished: finished %>
      <% end %>
    </div>
  <% end %>
</div>
