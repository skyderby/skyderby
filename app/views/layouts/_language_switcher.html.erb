<%# locals: (variant:) %>
<%
  locale_local_names =
    {
      en: 'English',
      ru: 'Русский',
      de: 'Deutsch',
      fr: 'Français',
      it: 'Italiano',
      es: 'Español'
    }

  sheet = variant == :mobile
  menu_id = "language-menu-#{variant}"
%>

<div class="language-switcher <%= 'language-switcher--sheet' if sheet %>" data-controller="dropdown">
  <button class="dropdown-toggle button button--ghost button--sm" popovertarget="<%= menu_id %>" aria-label="<%= t('application.accessibility.current_language', language: locale_local_names[I18n.locale]) %>">
    <%= image_tag asset_path('blank.gif'), class: "flag flag-#{I18n.locale}", alt: "" %>
    <% if sheet %>
      <span><%= locale_local_names[I18n.locale] %></span>
    <% end %>
    <%= icon_tag 'angle-up-solid' %>
  </button>

  <div id="<%= menu_id %>" popover class="<%= class_names('sd-dropdown-menu', sheet ? 'sd-dropdown-menu--sheet' : 'sd-dropdown-menu--up') %>" data-dropdown-target="menu">
    <% if sheet %>
      <div class="dropdown-header"><%= t('application.accessibility.change_language') %></div>
    <% end %>
    <% I18n.available_locales.each do |locale| %>
      <% active = I18n.locale == locale %>
      <%= link_to( {locale: }, rel: 'nofollow', data: { 'turbo-prefetch': 'false' }, class: class_names('dropdown-item', active && 'active'), aria: { current: active ? 'true' : nil }) do %>
        <%= image_tag asset_path('blank.gif'), class: "flag flag-#{locale}", alt: "" %>
        <%= locale_local_names[locale] %>
      <% end %>
    <% end %>
  </div>
</div>
