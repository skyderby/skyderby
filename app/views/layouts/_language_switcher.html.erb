<%# locals: (variant:) %>
<%
  locale_local_names =
    {
      en: 'English',
      ru: 'Русский',
      de: 'Deutsch',
      fr: 'Français',
      it: 'Italiano',
      es: 'Español'
    }

  current_language_label = t('application.accessibility.current_language', language: locale_local_names[I18n.locale])
  current_flag = image_tag(asset_path('blank.gif'), class: "flag flag-#{I18n.locale}", alt: "")
  menu_id = "language-menu-#{variant}"

  locale_links = capture do
    I18n.available_locales.each do |locale|
      active = I18n.locale == locale
      concat(
        link_to({ locale: }, rel: 'nofollow', data: { 'turbo-prefetch': 'false' }, class: class_names('dropdown-item', active && 'active'), aria: { current: active ? 'true' : nil }) do
          safe_join([image_tag(asset_path('blank.gif'), class: "flag flag-#{locale}", alt: ""), locale_local_names[locale]])
        end
      )
    end
  end
%>

<% if variant == :mobile %>
  <div class="language-switcher">
    <button type="button" class="dropdown-toggle button button--ghost button--sm" aria-haspopup="dialog" aria-label="<%= current_language_label %>" data-controller="modal-trigger" data-template-id="<%= menu_id %>" data-action="modal-trigger#open">
      <%= current_flag %>
    </button>

    <template id="<%= menu_id %>">
      <%= render layout: 'components/dialog', locals: { title: t('application.accessibility.change_language') } do %>
        <nav class="sd-dropdown-menu sd-dropdown-menu--embedded">
          <%= locale_links %>
        </nav>
      <% end %>
    </template>
  </div>
<% else %>
  <div class="language-switcher" data-controller="dropdown">
    <button class="dropdown-toggle button button--ghost button--sm" popovertarget="<%= menu_id %>" aria-label="<%= current_language_label %>">
      <%= current_flag %>
      <%= icon_tag 'angle-up-solid' %>
    </button>

    <div id="<%= menu_id %>" popover class="sd-dropdown-menu sd-dropdown-menu--up" data-dropdown-target="menu">
      <%= locale_links %>
    </div>
  </div>
<% end %>
