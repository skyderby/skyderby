<% current_theme = color_theme || 'system' %>
<div class="segmented-control segmented-control--inline" role="group" aria-label="<%= t('themes.label') %>" data-controller="theme" data-action="theme:change@window->theme#sync">
  <% { light: 'sun', dark: 'moon', system: 'circle-half' }.each do |choice, icon| %>
    <% active = current_theme == choice.to_s %>
    <button type="button"
            class="<%= class_names('segmented-control-option', active:) %>"
            title="<%= t("themes.#{choice}") %>"
            aria-label="<%= t("themes.#{choice}") %>"
            aria-pressed="<%= active %>"
            data-theme-target="option"
            data-theme-choice-param="<%= choice %>"
            data-action="theme#select">
      <%= icon_tag icon %>
    </button>
  <% end %>
</div>
