<%# locals: (terrain_profile:, scope:) %>

<% menu_id = "terrain-profile-menu-#{scope}-#{terrain_profile.id}" %>

<li class="explorer-list-item terrain-profile-item"
    data-terrain-profiles-target="item"
    data-id="<%= terrain_profile.id %>"
    data-name="<%= terrain_profile.full_name %>">
  <a href="#" data-action="terrain-profiles#toggle">
    <span class="terrain-profile-item-name">
      <% if terrain_profile.place %>
        <%= terrain_profile.place.name %>
      <% else %>
        <%= terrain_profile.name %>
      <% end %>
      <%= render 'terrain_profiles/sharing_badge', terrain_profile: %>
    </span>
    <% if terrain_profile.place %>
      <span class="terrain-profile-item-secondary"><%= terrain_profile.name %></span>
    <% end %>
  </a>

  <% if terrain_profile.removable_by? %>
    <span class="terrain-profile-item-actions">
      <% unless terrain_profile.published? %>
        <span class="pill pill-blue-gray"><%= t('terrain_profiles.draft') %></span>
      <% end %>

      <div class="terrain-profile-item-menu" data-controller="dropdown">
        <button class="dropdown-toggle button button--ghost button--sm"
                popovertarget="<%= menu_id %>"
                title="<%= t('terrain_profiles.index.actions') %>">
          <%= icon_tag 'ellipsis-vertical-solid' %>
        </button>

        <div id="<%= menu_id %>"
             popover
             class="sd-dropdown-menu"
             data-dropdown-target="menu">
          <% if terrain_profile.editable? %>
            <%= link_to t('general.edit'),
                        edit_terrain_profile_path(terrain_profile),
                        class: 'dropdown-item' %>
          <% end %>

          <% if terrain_profile.shareable_with_users? %>
            <%= button_to t('terrain_profiles.index.share'),
                          new_terrain_profile_share_path(terrain_profile),
                          method: :get,
                          form: { data: { turbo_stream: true } },
                          class: 'dropdown-item' %>
          <% end %>

          <% owned = terrain_profile.deletable? %>
          <%= button_to owned ? t('general.delete') : t('terrain_profiles.index.remove_share'),
                        terrain_profile_path(terrain_profile),
                        method: :delete,
                        form: {
                          data: {
                            turbo_confirm: owned ? t('general.confirm_delete') : t('terrain_profiles.index.confirm_remove_share')
                          }
                        },
                        class: 'dropdown-item' %>
        </div>
      </div>
    </span>
  <% end %>
</li>
