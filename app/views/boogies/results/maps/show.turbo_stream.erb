<%= turbo_stream.update 'modal-root' do %>
  <% if user_signed_in? %>
    <% editable = @event.editable? && !@event.finished? && !@result.round.completed? %>

    <%= render partial: 'map',
               layout: 'components/dialog',
               locals: {
                 header_actions: render('components/open_track_button', track_id: @result.track_id),
                 title: event_result_presentation(@result),
                 dialog_size: 'lg',
                 modal: true,
                 result: @result,
                 editable:
               } %>
  <% else %>
    <%= render layout: 'components/dialog', locals: { title: event_result_presentation(@result), dialog_size: 'lg', header_actions: render('components/open_track_button', track_id: @result.track_id) } do %>
      <div class="sd-container">
        <%= render 'boogies/results/navbar', result: @result, modal: true %>
        <%= render 'components/maps_auth_wall' %>
      </div>
    <% end %>
  <% end %>
<% end %>
