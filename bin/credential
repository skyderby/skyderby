#!/usr/bin/env ruby
# Prints one value from the production credentials: bin/credential kamal.registry_password

require 'English'
require 'yaml'

path = ARGV.fetch(0) { abort 'usage: bin/credential section.key' }
yaml = `#{File.expand_path('rails', __dir__)} credentials:show --environment production`
abort 'could not read production credentials' unless $CHILD_STATUS.success?

value = YAML.safe_load(yaml).dig(*path.split('.'))
abort "#{path} is empty in config/credentials/production.yml.enc" if value.to_s.empty?
puts value
